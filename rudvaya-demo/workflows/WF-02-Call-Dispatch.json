      "notes": "CREDENTIAL REQUIRED. Verified against installed n8n-nodes-bolna v0.1.2: userData must be a JSON STRING (the node calls JSON.parse on it internally), not a live object — wrapped with JSON.stringify()."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE call_attempts SET provider_call_id = $2, status = 'queued' WHERE id = $1;",
        "options": {
