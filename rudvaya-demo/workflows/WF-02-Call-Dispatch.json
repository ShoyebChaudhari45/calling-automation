      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED. Confirmed from Bolna's API reference: POST /call returns { message, status, execution_id }."
    },
