{
  "name": "WF-05 · Callback Scheduler",
  "nodes": [
    {
      "parameters": {
        "content": "## WF-05 · Callback Scheduler\n\n**Credentials needed:** 'Claim Due Tasks', 'Re-check Lead', 'Close Task (Done)', 'Close Task (Cancelled)' — your Supabase Postgres credential.\n\n**REPLACE after import:** 'Dial Again' node's workflowId must point at WF-02's imported id.\n\nRuns every 1 minute for the demo (production: every 5 minutes — change the Schedule Trigger interval, not app_config, since cron cadence isn't a runtime setting).",
        "height": 220,
        "width": 460
      },
      "id": "e5000000-0001-4000-8000-000000000001",
      "name": "Sticky: Credentials & TODO",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -320,
        -220
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "e5000000-0002-4000-8000-000000000002",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followup_tasks\n  SET status = 'processing', locked_at = now(), attempt_count = attempt_count + 1\n  WHERE id IN (\n    SELECT id FROM followup_tasks\n    WHERE status = 'pending' AND due_at <= now()\n    ORDER BY due_at\n    LIMIT 5\n    FOR UPDATE SKIP LOCKED)\nRETURNING id, lead_id, task_type;"
      },
      "id": "e5000000-0003-4000-8000-000000000003",
      "name": "Claim Due Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        120,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED. FOR UPDATE SKIP LOCKED guarantees a callback is never claimed by two overlapping runs."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e5000000-0004-4000-8000-000000000004",
              "leftValue": "={{$input.all().length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e5000000-0005-4000-8000-000000000005",
      "name": "Any Tasks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "e5000000-0006-4000-8000-000000000006",
      "name": "Loop Tasks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id AS lead_id, l.do_not_contact, l.status, l.attempt_count,\n       (SELECT value FROM app_config WHERE key = 'max_attempts') AS max_attempts,\n       EXISTS (SELECT 1 FROM appointments ap WHERE ap.lead_id = l.id AND ap.status IN ('requested','confirmed')) AS has_active_appointment,\n       EXISTS (SELECT 1 FROM messages m WHERE m.lead_id = l.id AND m.direction = 'in' AND m.created_at > (SELECT created_at FROM followup_tasks WHERE id = $2)) AS replied_since_task\nFROM leads l WHERE l.id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id, $json.id] }}"
        }
      },
      "id": "e5000000-0007-4000-8000-000000000007",
      "name": "Re-check Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        780,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const task = $('Loop Tasks').item.json;\nconst l = $json;\nlet cancel = null;\nif (l.do_not_contact) cancel = 'opted_out';\nelse if (l.replied_since_task) cancel = 'customer_replied';\nelse if (l.has_active_appointment) cancel = 'appointment_exists';\nelse if (l.attempt_count >= Number(l.max_attempts)) cancel = 'max_attempts';\nreturn { json: { ...l, task_id: task.id, eligible: !cancel, cancel_reason: cancel } };"
      },
      "id": "e5000000-0008-4000-8000-000000000008",
      "name": "Still Eligible Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e5000000-0009-4000-8000-000000000009",
              "leftValue": "={{$json.eligible}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e5000000-0010-4000-8000-000000000010",
      "name": "Still Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1220,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": "7f304555-2a66-4260-9663-de1749451a7f",
        "workflowInputs": {
          "value": {
            "lead_id": "={{$json.lead_id}}",
            "reason": "callback"
          }
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "e5000000-0011-4000-8000-000000000011",
      "name": "Dial Again",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1440,
        -100
      ],
      "notes": "REPLACE workflowId with WF-02's id after import. WF-02 re-runs the FULL eligibility gate (calling window, allowlist) before actually dialing."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followup_tasks SET status = 'done', completed_at = now() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.task_id] }}"
        }
      },
      "id": "e5000000-0012-4000-8000-000000000012",
      "name": "Close Task (Done)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1660,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followup_tasks SET status = 'cancelled', cancellation_reason = $2, completed_at = now() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.task_id, $json.cancel_reason] }}"
        }
      },
      "id": "e5000000-0013-4000-8000-000000000013",
      "name": "Close Task (Cancelled)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        140
      ],
      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED."
    }
  ],
