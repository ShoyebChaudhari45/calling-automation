    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TEMPLATES = {\n  missed_call: (n, p) => `Hi ${n}, this is the ${p} team. We tried calling about your enquiry. Reply with a good time to call, or VISIT to book a site visit. Reply STOP to opt out.`,\n  brochure: (n, p) => `Thanks for speaking with us, ${n}! Here are the ${p} details: 2 & 3 BHK, clubhouse, pool. Would you like to visit this week?`,\n  visit_ack: (n, p, ctx) => `Thank you ${n}. We've noted your request for a visit on ${ctx.requested_time_text || 'the requested time'}. Our team will confirm shortly.`,\n  callback_ack: (n, p, ctx) => `Sure ${n}, we'll call you at ${ctx.callback_time || 'the requested time'}.`,\n  optout_ack: (n) => `Understood, ${n}. You won't receive further messages or calls from us.`\n};\nconst name = $json.name;\nconst property = $json.property_interest || 'Aranya Heights';\nconst fn = TEMPLATES[$json.template_name] || TEMPLATES.brochure;\nreturn { json: { ...$json, body: fn(name, property, $json) } };"
      },
      "id": "d4000000-0015-4000-8000-000000000015",
      "name": "Render Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
