    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ENUM_INTENT = ['interested','callback','site_visit','office_visit','not_interested','opt_out','complaint','unknown'];\nlet r, errors = [];\ntry {\n  const raw = $json.choices?.[0]?.message?.content;\n  r = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  return { json: { valid: false, errors: ['not_json'] } };\n}\nif (!ENUM_INTENT.includes(r.intent)) errors.push('intent');\nif (r.callback_time && isNaN(Date.parse(r.callback_time))) r.callback_time = null;\n\nconst leadId = $('Save Inbound').first().json.lead_id;\nreturn { json: { valid: errors.length === 0, errors, result: r, lead_id: leadId } };"
      },
