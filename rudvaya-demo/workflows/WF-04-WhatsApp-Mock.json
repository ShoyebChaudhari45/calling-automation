        "jsonBody": "={{ JSON.stringify({\n  model: $json.openai_model,\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'Classify a customer WhatsApp reply to a real-estate follow-up. Return only JSON: {\"intent\": \"interested | callback | site_visit | office_visit | not_interested | opt_out | complaint | unknown\", \"callback_time\": ISO_or_null, \"requested_visit_time_text\": string_or_null, \"summary\": short_string}. \"STOP\", \"no more messages\", \"dont contact me\" (any language) = opt_out.' },\n    { role: 'user', content: $('Customer Reply').first().json.body.text }\n  ]\n}) }}",
        "options": {}
