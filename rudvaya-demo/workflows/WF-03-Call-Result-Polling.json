    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const call = $('Outcome Check').itemMatching($itemIndex) ? $('Outcome Check').itemMatching($itemIndex).json : $('Init Poll State').first().json;\nreturn {\n  json: {\n    ...call,\n    property: $json.property,\n    openai_model: $json.openai_model\n  }\n};"
      },
      "id": "c3000000-0024-4000-8000-000000000024",
      "name": "Merge Facts Into Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        -200
      ],
      "notes": "Combines the call/transcript data (from Outcome Check for live calls, or from the trigger for simulated calls) with property facts + model name. TODO: verify itemMatching behaviour across the two different incoming branches when testing — if items don't line up, replace with a straightforward $('Outcome Check').first().json / $('Init Poll State').first().json pair depending on $json.mode."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.openai_model,\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'You analyse transcripts of calls between an AI sales assistant and a real-estate lead. Return ONLY a JSON object, no other text, with exactly these fields: { \"lead_status\": \"interested | callback | visit_requested | not_interested | opted_out | escalated | review\", \"customer_sentiment\": \"happy | neutral | confused | busy | frustrated | angry\", \"interested\": true|false, \"budget\": string|null, \"property_type\": \"2BHK | 3BHK | other | unknown\", \"location\": string|null, \"callback_required\": true|false, \"callback_time\": ISO8601_or_null, \"site_visit_requested\": true|false, \"office_visit_requested\": true|false, \"requested_visit_time_text\": string|null, \"opt_out\": true|false, \"escalation_required\": true|false, \"summary\": \"2 sentences max, no phone numbers\" }. Rules: opt_out true implies lead_status=opted_out. A visit is requested only if the customer clearly agrees. escalation_required true for complaints, legal/safety issues, or human requests. Convert relative times using the call time provided. If transcript is too short/unclear use lead_status review.' },\n    { role: 'user', content: 'Call time (Asia/Kolkata): ' + new Date().toISOString() + '\\nProperty facts: ' + JSON.stringify($json.property) + '\\nTranscript:\\n' + ($json.transcript || '') }\n  ]\n}) }}",
        "options": {}
      },
      "id": "c3000000-0025-4000-8000-000000000025",
      "name": "Classify Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        -200
      ],
      "credentials": {
        "openAiApi": {
          "id": "b763713c-92f4-4805-b42a-f076ab934e56",
          "name": "Rudvaya OpenAI"
        }
      },
      "notes": "CREDENTIAL REQUIRED (OpenAI). Uses HTTP Request with Predefined Credential Type = OpenAi so the Bearer header is handled by n8n. Model name always comes from app_config.openai_model via Load Facts + Model — never hardcoded."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ENUM = {\n  lead_status: ['interested','callback','visit_requested','not_interested','opted_out','escalated','review'],\n  customer_sentiment: ['happy','neutral','confused','busy','frustrated','angry'],\n  property_type: ['2BHK','3BHK','other','unknown']\n};\nconst BOOL = ['interested','callback_required','site_visit_requested','office_visit_requested','opt_out','escalation_required'];\n\nlet r, errors = [];\ntry {\n  const raw = $json.choices?.[0]?.message?.content;\n  r = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n} catch (e) {\n  return { json: { valid: false, errors: ['not_json'] } };\n}\nfor (const [k, vals] of Object.entries(ENUM)) if (!vals.includes(r[k])) errors.push(k);\nfor (const k of BOOL) if (typeof r[k] !== 'boolean') errors.push(k);\nif (r.opt_out && r.lead_status !== 'opted_out') r.lead_status = 'opted_out';\nif (r.callback_time && isNaN(Date.parse(r.callback_time))) r.callback_time = null;\n\nconst callCtx = $('Merge Facts Into Call').first().json;\nreturn { json: { valid: errors.length === 0, errors, result: r, call_attempt_id: callCtx.call_attempt_id, lead_id: callCtx.lead_id, duration_seconds: callCtx.duration_seconds, recording_url: callCtx.recording_url, transcript: callCtx.transcript } };"
      },
      "id": "c3000000-0026-4000-8000-000000000026",
      "name": "Validate JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
