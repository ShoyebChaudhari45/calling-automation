    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Field names confirmed against Bolna's live API docs (executions/get_execution).\nconst r = $json;\nconst prev = $('Init Poll State').item.json;\nconst pollCount = (prev.poll_count || 0) + 1;\n\nconst status = (r.status || '').toLowerCase();\nconst IN_FLIGHT = ['scheduled', 'queued', 'rescheduled', 'initiated', 'ringing', 'in-progress'];\nconst terminal = !IN_FLIGHT.includes(status);\n\nreturn {\n  json: {\n    ...prev,\n    poll_count: pollCount,\n    bolna_status: status,\n    terminal,\n    transcript: r.transcript || null,\n    bolna_summary: r.summary || null,\n    duration_seconds: r.conversation_duration ?? r.telephony_data?.duration ?? null,\n    recording_url: r.telephony_data?.recording_url || null\n  }\n};"
      },
