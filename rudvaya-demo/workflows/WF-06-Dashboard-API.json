    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) AS items FROM (\n  SELECT l.id, l.name, l.phone_e164, l.status, l.attempt_count, l.do_not_contact,\n         ca.started_at AS last_call_at, ca.ended_at AS last_call_ended_at, ca.status AS last_call_status, ca.mode AS last_call_mode,\n         ca.duration_seconds AS last_call_duration_seconds, ca.transcript AS last_call_transcript,\n         ca.summary AS last_call_summary, ca.classification AS last_call_classification, ca.recording_url AS last_call_recording_url,\n         ft.due_at AS next_task_due_at, ft.status AS next_task_status\n  FROM leads l\n  LEFT JOIN LATERAL (\n    SELECT * FROM call_attempts WHERE lead_id = l.id ORDER BY started_at DESC LIMIT 1\n  ) ca ON true\n  LEFT JOIN LATERAL (\n    SELECT * FROM followup_tasks WHERE lead_id = l.id AND status = 'pending' ORDER BY due_at ASC LIMIT 1\n  ) ft ON true\n  ORDER BY l.created_at DESC\n  LIMIT 200\n) t;"
      },
