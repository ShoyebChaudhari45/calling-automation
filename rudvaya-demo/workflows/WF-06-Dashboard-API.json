        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f0000000-0090-4000-8000-000000000090",
      "name": "POST /api/allowlist/add",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -60,
        860
      ],
      "webhookId": "wf06-api-allowlist-add"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.body && $json.body.phone) || '';\nlet digits = String(raw).replace(/[^\\d+]/g, '');\nlet phone = null;\nif (/^\\+91[6-9]\\d{9}$/.test(digits)) phone = digits;\nelse if (/^91[6-9]\\d{9}$/.test(digits)) phone = '+' + digits;\nelse if (/^0?[6-9]\\d{9}$/.test(digits)) phone = '+91' + digits.slice(-10);\nreturn [{ json: { phone_e164: phone, valid: !!phone } }];"
      },
      "id": "f0000000-0091-4000-8000-000000000091",
      "name": "Normalize New Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        860
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "allow1",
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "f0000000-0092-4000-8000-000000000092",
      "name": "Valid Number?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        860
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE app_config\nSET value = CASE\n  WHEN value = '' THEN $1\n  WHEN (',' || value || ',') LIKE ('%,' || $1 || ',%') THEN value\n  ELSE value || ',' || $1\nEND\nWHERE key = 'call_allowlist'\nRETURNING value;",
        "options": {
          "queryReplacement": "={{ [$json.phone_e164] }}"
        }
      },
      "id": "f0000000-0093-4000-8000-000000000093",
      "name": "Update Allowlist",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        600,
        780
      ],
      "credentials": {
        "postgres": {
          "id": "32a87679-ef80-4766-b60d-01651c64da42",
          "name": "Rudvaya Supabase Postgres"
        }
      },
      "notes": "CREDENTIAL REQUIRED. This only controls which numbers demo_mode will allow Bolna to call -- it does NOT verify the number with Bolna. The number must ALSO be verified in the Bolna dashboard (profile menu -> Verified Numbers) before a live call will actually connect."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const value = $input.first().json.value || '';\nreturn [{ json: { ok: true, numbers: value.split(',').map(s => s.trim()).filter(Boolean) } }];"
      },
      "id": "f0000000-0094-4000-8000-000000000094",
