    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) AS items FROM (\n  SELECT 'call' AS kind, ca.id, ca.lead_id, l.name AS lead_name, ca.status AS detail,\n         (CASE WHEN ca.mode = 'live_bolna' THEN 'LIVE' ELSE 'SIMULATED' END) AS badge, ca.started_at AS at\n  FROM call_attempts ca JOIN leads l ON l.id = ca.lead_id\n  UNION ALL\n  SELECT 'message', m.id, m.lead_id, l.name, COALESCE(m.template_name, m.direction),\n         (CASE WHEN m.simulated THEN 'SIMULATED' ELSE 'LIVE' END), m.created_at\n  FROM messages m JOIN leads l ON l.id = m.lead_id\n  UNION ALL\n  SELECT 'audit', ae.id, ae.lead_id, NULL, ae.event_type, 'SYSTEM', ae.created_at\n  FROM audit_events ae\n  ORDER BY at DESC\n  LIMIT 30\n) t;"
      },
