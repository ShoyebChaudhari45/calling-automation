        -60,
        1040
      ],
      "webhookId": "wf06-api-lead-add"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body || {};\nconst name = (b.name || '').trim();\nlet digits = String(b.phone || '').replace(/[^\\d+]/g, '');\nlet phone = null;\nif (/^\\+91[6-9]\\d{9}$/.test(digits)) phone = digits;\nelse if (/^91[6-9]\\d{9}$/.test(digits)) phone = '+' + digits;\nelse if (/^0?[6-9]\\d{9}$/.test(digits)) phone = '+91' + digits.slice(-10);\nlet reason = null;\nif (!name) reason = 'missing_name';\nelse if (!phone) reason = 'invalid_phone';\nreturn [{ json: { valid: !reason, reason, name, phone_e164: phone } }];"
      },
      "id": "f0000000-00a1-4000-8000-0000000000a1",
      "name": "Normalize New Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        1040
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "lead1",
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "f0000000-00a2-4000-8000-0000000000a2",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        1040
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (client_id, name, phone_e164, source, consent, consent_source, consent_at)\nVALUES ('demo', $1, $2, 'dashboard', true, 'dashboard_manual', now())\nON CONFLICT (client_id, phone_e164) DO UPDATE SET name = EXCLUDED.name, updated_at = now()\nRETURNING id, name, phone_e164, status;",
        "options": {
          "queryReplacement": "={{ [$json.name, $json.phone_e164] }}"
        }
      },
      "id": "f0000000-00a3-4000-8000-0000000000a3",
      "name": "Upsert New Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
