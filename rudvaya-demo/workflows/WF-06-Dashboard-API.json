      "id": "f0000000-0040-4000-8000-000000000040",
      "name": "GET /api/appointments",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -60,
        -40
      ],
      "webhookId": "wf06-api-appointments"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json) AS items FROM (\n  SELECT a.id, a.type, a.requested_time_text, a.scheduled_at, a.status, a.assigned_to, a.notes, a.simulated, a.created_at,\n         l.name AS lead_name, l.phone_e164\n  FROM appointments a\n  JOIN leads l ON l.id = a.lead_id\n  ORDER BY a.created_at DESC\n  LIMIT 100\n) t;"
      },
      "id": "f0000000-0041-4000-8000-000000000041",
      "name": "Query Appointments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
